{
  "name": "morph",
  "version": "0.1.0",
  "private": true,
  "description": "MORPH — a self-adaptive, autonomously-curating web platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sim": "pnpm --filter @morph/adaptive run sim",
    "report:sample": "pnpm --filter @morph/telegram run sample",
    "bench": "k6 run bench/ingest.js && k6 run bench/render.js",
    "bench:ingest": "k6 run bench/ingest.js",
    "bench:render": "k6 run bench/render.js",
    "bench:spike": "k6 run bench/spike.js",
    "bench:soak": "k6 run bench/soak.js",
    "bench:smoke": "k6 run -e MODE=smoke bench/ingest.js && k6 run -e MODE=smoke bench/render.js && k6 run -e MODE=smoke bench/spike.js && k6 run -e MODE=smoke bench/soak.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm guardrails && pnpm test:coverage && pnpm test:workers && pnpm build",
    "typecheck:direct": "node scripts/run-all.mjs typecheck",
    "build:direct": "node scripts/run-all.mjs build",
    "verify:direct": "pnpm typecheck:direct && pnpm lint && pnpm guardrails && pnpm test:coverage && pnpm test:workers && pnpm build:direct",
    "lint:fix": "eslint . --fix",
    "guardrails": "node scripts/check-guardrails.mjs",
    "seed:generate": "tsx scripts/seed-d1.ts",
    "test:workers": "vitest run --config apps/api/vitest.workers.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@morph/core": "workspace:^",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "undici": "^7.29.1",
      "source-map-js": "^1.2.2",
      "sharp": "^0.35.5",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7"
    },
    "ignoredOptionalDependencies": [
      "sharp"
    ]
  }
}
