# =============================================================================
# MORPH - environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
# Every variable is validated at process start by `@morph/core/env`; a missing or
# malformed value fails the boot loudly instead of surfacing as a 3am mystery.
#
# Legend:  [required]  must be set for the service to boot
#          [optional]  has a safe default
#          [secret]    high-value credential - rotate on exposure
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# [required] development | test | production. Controls logging verbosity,
# consent-gate strictness (dev allows a bypass flag, production never does) and
# whether the adaptive engine may write to `adaptation_log`.
NODE_ENV=development

# [required] Public origin of the site, no trailing slash. Used for OAuth
# callbacks, canonical URLs, sitemap entries, OG image URLs and the crawler's
# User-Agent contact link. Must be https in production.
MORPH_PUBLIC_URL=http://localhost:3000

# [optional] IANA timezone the operator lives in. Drives the hourly report clock,
# quiet hours, and the hour-of-week features of the contextual bandit.
MORPH_TIMEZONE=Europe/Rome

# [optional] Free-form deployment label surfaced in traces and the report header.
MORPH_ENVIRONMENT_NAME=local

# -----------------------------------------------------------------------------
# PostgreSQL 16 - source of truth
# -----------------------------------------------------------------------------
# [required][secret] Full connection string. Use a dedicated role per app with
# least privilege: `morph_web` (read + session writes), `morph_api` (write),
# `morph_worker` (write). Migrations run separately as `morph_migrator`.
DATABASE_URL=postgres://morph:morph@localhost:5432/morph

# [optional] Pool sizing. Rule of thumb: (vCPU * 2) + effective_spindle_count,
# divided across the number of app replicas. Too large a pool is slower, not faster.
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# ClickHouse - behavioural event store
# -----------------------------------------------------------------------------
# [required] HTTP endpoint of the ClickHouse server.
CLICKHOUSE_URL=http://localhost:8123
# [required] Database holding the event tables and materialised views.
CLICKHOUSE_DATABASE=morph
# [required][secret] Credentials. The ingest path uses an INSERT-only user; the
# adaptive aggregator uses a SELECT-only user. Never share one superuser.
CLICKHOUSE_USER=morph
CLICKHOUSE_PASSWORD=change-me
# [optional] Async-insert settings. These are what let a single node absorb
# 5k req/s of ingest without one-part-per-insert write amplification.
CLICKHOUSE_ASYNC_INSERT=1
CLICKHOUSE_WAIT_FOR_ASYNC_INSERT=0

# -----------------------------------------------------------------------------
# Redis 7 - assignment cache, posteriors, rate limits, queues, sessions
# -----------------------------------------------------------------------------
# [required][secret]
REDIS_URL=redis://localhost:6379
# [optional] Logical separation by prefix so one Redis can serve every role while
# remaining greppable and independently flushable.
REDIS_PREFIX_ASSIGNMENT=asg:
REDIS_PREFIX_POSTERIOR=post:
REDIS_PREFIX_RATELIMIT=rl:
REDIS_PREFIX_SESSION=sess:
# [optional] Sticky-assignment TTL, seconds. 30 days - long enough that a
# returning visitor sees a stable site, short enough to bound the keyspace.
ASSIGNMENT_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# Redpanda (Kafka API) - ingest buffer
# -----------------------------------------------------------------------------
# [required] Comma-separated broker list.
REDPANDA_BROKERS=localhost:19092
# [optional] Topic names. Keep them versioned: a schema change ships as a new
# topic, and the consumer drains both during the migration window.
REDPANDA_TOPIC_EVENTS=morph.events.v1
REDPANDA_TOPIC_DLQ=morph.events.dlq.v1
# [optional] Producer batching. 5ms of linger is invisible to a user and cuts
# broker round-trips by an order of magnitude at peak.
REDPANDA_LINGER_MS=5
REDPANDA_BATCH_BYTES=65536

# -----------------------------------------------------------------------------
# Privacy and identity  (see docs/PRIVACY.md)
# -----------------------------------------------------------------------------
# [required][secret] Server-side pepper for the daily anonymous visitor id.
# The id is sha256(pepper + daily_salt + ip + user_agent), truncated. The raw IP
# is never stored, never logged, and never leaves the edge process.
# Generate with: openssl rand -hex 32
ANON_ID_PEPPER=replace-with-openssl-rand-hex-32

# [optional] Days of raw event retention before ClickHouse TTL rolls rows up into
# aggregates only. 90 is the documented GDPR commitment - changing it here without
# changing docs/PRIVACY.md is a compliance bug.
RAW_EVENT_RETENTION_DAYS=90

# [optional] Set to `1` ONLY in local development to skip the consent gate while
# building UI. Reading this as truthy in production is a hard boot failure.
MORPH_DEV_BYPASS_CONSENT=0

# -----------------------------------------------------------------------------
# Adaptive engine  (see packages/adaptive)
# -----------------------------------------------------------------------------
# [optional] Share of traffic pinned to the untouched baseline so the true lift of
# the whole system stays measurable. Changing this invalidates lift comparisons -
# record the change in `adaptation_log`.
HOLDOUT_FRACTION=0.05
# [optional] Exploration never collapses to zero; the world changes.
EXPLORATION_FLOOR=0.02
# [optional] Impressions a variant must accumulate before it may be retired.
MIN_IMPRESSIONS_BEFORE_RETIRE=1000
# [optional] Always-valid sequential test threshold (mSPRT). 0.05 = 95% confidence.
MSPRT_ALPHA=0.05
# [optional] Hours during which a brand-new variant's reward is down-weighted to
# neutralise the novelty effect.
NOVELTY_DECAY_HOURS=48
# [optional] Master switch. `0` freezes assignment on current champions -
# the site keeps working, it just stops learning. Set by `/pause_adaptation`.
ADAPTATION_ENABLED=1

# -----------------------------------------------------------------------------
# Anthropic API - variant generation, content generation, report composition
# -----------------------------------------------------------------------------
# [required][secret] https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-me
# [optional] Model per workload. Generation quality matters most for on-site
# content; the hourly report is a formatting-heavy job that a smaller model does
# well and cheaply.
ANTHROPIC_MODEL_GENERATION=claude-opus-5
ANTHROPIC_MODEL_REPORT=claude-sonnet-5
ANTHROPIC_MODEL_CLASSIFIER=claude-haiku-4-5-20251001
# [optional] Hard monthly spend ceiling in USD. The worker refuses to start a
# generation batch that would cross it and reports the refusal to Telegram.
ANTHROPIC_MONTHLY_BUDGET_USD=200

# -----------------------------------------------------------------------------
# Telegram  (see packages/telegram)
# -----------------------------------------------------------------------------
# [required][secret] From @BotFather.
TELEGRAM_BOT_TOKEN=replace-me
# [required] The ONLY chat id the bot will talk to or accept commands from.
# Every other chat is ignored silently. This is the bot's entire access control.
TELEGRAM_CHAT_ID=replace-me
# [optional] Comma-separated Telegram user ids permitted to issue mutating
# commands (/promote, /kill, ...). Read-only commands need only the chat id.
TELEGRAM_ADMIN_USER_IDS=
# [optional] Local hours during which only genuine alerts are delivered.
TELEGRAM_QUIET_HOURS=01-07

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5) - see section 4
# -----------------------------------------------------------------------------
# [required][secret] openssl rand -base64 32
AUTH_SECRET=replace-me
# [optional] Set to `true` behind Caddy so Auth.js trusts X-Forwarded-* headers.
AUTH_TRUST_HOST=true

# Each provider is optional: an unset client id simply removes that button from
# the sign-in surface, and the adaptive provider-ordering surface adapts its
# variant space accordingly. Request the MINIMUM scope; never posting scope.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TIKTOK_ID=
AUTH_TIKTOK_SECRET=
AUTH_X_ID=
AUTH_X_SECRET=
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=
AUTH_REDDIT_ID=
AUTH_REDDIT_SECRET=
AUTH_SPOTIFY_ID=
AUTH_SPOTIFY_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# [optional] Magic-link email transport.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=hello@example.com

# [optional] Cloudflare Turnstile guards the email path only. OAuth paths are
# already rate-limited by the provider.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Social connectors - OPERATOR-OWNED ACCOUNTS ONLY  (see docs/COMPLIANCE.md)
# -----------------------------------------------------------------------------
# These credentials authenticate MORPH as the operator's own account, via each
# platform's official API. There is deliberately no variable here for a visitor's
# credentials, and none for a proxy pool: MORPH never posts as a visitor and never
# evades a rate limit. OAuth refresh tokens are encrypted at rest with the key below.
#
# [required if any connector enabled][secret] AES-256-GCM key for token encryption.
# openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY=

X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_IG_USER_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=morph/0.1 (by /u/your-account; +https://example.com/bot)

YOUTUBE_API_KEY=

# [optional] Autonomy level of the outbound approval queue: manual | review | auto.
# Defaults to `review`. `auto` is only honoured for content that passed the safety
# classifier AND matches an operator-approved template.
SOCIAL_AUTONOMY=review
# [optional] Hard daily ceiling on outbound actions per platform, deliberately set
# well below each platform's documented limit.
SOCIAL_DAILY_ACTION_CAP=40

# -----------------------------------------------------------------------------
# Crawler  (see section 3 and docs/COMPLIANCE.md)
# -----------------------------------------------------------------------------
# [required] Descriptive User-Agent WITH a contact URL. Anonymous crawling is
# not acceptable behaviour and gets you blocked, correctly.
CRAWLER_USER_AGENT=MorphBot/0.1 (+https://example.com/bot; contact@example.com)
# [optional] Politeness. One concurrent request per host is not negotiable;
# the QPS cap is the additional global brake.
CRAWLER_MAX_CONCURRENCY_PER_HOST=1
CRAWLER_GLOBAL_QPS=8
CRAWLER_DEFAULT_CRAWL_DELAY_MS=1000
CRAWLER_ROBOTS_CACHE_TTL_SECONDS=86400
CRAWLER_TIMEOUT_MS=10000
# [optional] Hosts MORPH will never fetch, regardless of robots.txt.
CRAWLER_DENYLIST=

# -----------------------------------------------------------------------------
# Embeddings  (see D16 in docs/DECISIONS.md)
# -----------------------------------------------------------------------------
# [required in production] `deterministic` is a development stand-in: it hashes text
# into a vector of the right shape with NO semantic meaning at all. The worker refuses
# to boot with it when NODE_ENV=production, because a deployment using it would cluster
# documents by hash collision and score topics from noise while appearing healthy.
# Real values: `voyage` | `openai-compatible`.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=voyage-3-lite
# Must match the width of `crawl_document.embedding` and `trend_signal.centroid`.
# Changing it means a migration, not just a restart.
EMBEDDING_DIMENSIONS=768
# [required unless the provider is `deterministic`][secret]
EMBEDDING_API_KEY=
# [required for `openai-compatible`] Base URL of the service, without /embeddings.
EMBEDDING_BASE_URL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=morph
# [optional] Sample rate for traces. 1.0 in dev, ~0.05 at production volume.
OTEL_TRACES_SAMPLER_ARG=1.0
# [optional][secret]
SENTRY_DSN=
PROMETHEUS_METRICS_PORT=9464

# -----------------------------------------------------------------------------
# Ports (local compose)
# -----------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
ADMIN_PORT=3002
WORKER_HEALTH_PORT=3003
