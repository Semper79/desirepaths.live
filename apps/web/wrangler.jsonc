/**
 * The public renderer, as a Cloudflare Worker (D31).
 *
 * PLACEHOLDER IDS
 * Every `"id": "REPLACE_ME__*"` below is a resource that does not exist yet, because the
 * account does not exist yet. `infra/cloudflare/README.md` has the `wrangler` commands
 * that create each one and print the id to paste back here. They are left as loud
 * placeholders rather than plausible-looking hex so that a deploy attempted before they
 * are filled in fails immediately and obviously, instead of binding to nothing and
 * serving seed content that looks like a working site.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desirepath-web",

  /**
   * Pinned, so a deploy cannot land in the wrong account.
   *
   * Wrangler otherwise uses whatever account the active credentials point at. During the
   * domain work a `wrangler login` left this machine authenticated as a different
   * Cloudflare account, and a local `wrangler deploy` would have created a second set of
   * Workers there — new and empty, with none of the secrets, while the real ones kept
   * serving. Nothing would have failed; there would simply have been two.
   *
   * This is also the account the zone has to live in. A Worker route can only point at a
   * Worker in the same account as the zone, so the name and the account are one decision
   * rather than two (D2).
   */
  "account_id": "689efbf4a87359404ef6aca3dfdd85e0",
  "main": ".open-next/worker.js",

  /**
   * The renderer IS the origin for this hostname, so it is a Custom Domain (D2, D31).
   *
   * Cloudflare's own guidance: routes are for a hostname that already has an application
   * server behind it, Custom Domains for a hostname the Worker itself serves. Nothing is
   * behind this one — there is no origin to fall through to — so a route plus a
   * placeholder DNS record would be describing a topology that does not exist. The Custom
   * Domain also creates the DNS record and the certificate, which is the half of the old
   * Caddy setup nobody thinks about until the certificate expires.
   *
   * The apex only. `www` is not redirected here because a redirect belongs in a rule
   * rather than in a Worker that would have to boot to issue it.
   */
  "routes": [{ "pattern": "desirepath.live", "custom_domain": true }],

  /**
   * Pinned, not floating. The compatibility date decides runtime semantics, and a Worker
   * whose behaviour changes because time passed is the kind of outage nobody can bisect.
   * Moving it is a deliberate edit with the changelog read first.
   */
  "compatibility_date": "2026-09-01",

  /**
   * `nodejs_compat` is required by OpenNext: Next's server code reaches for `node:` builtins
   * — Buffer, streams, async_hooks — and without this flag the Worker fails at import time
   * rather than at the first request, which is at least an honest failure.
   */
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },

  /**
   * Observability on, and this one is not optional.
   *
   * `packages/metrics` does not survive the port — prom-client needs `node:cluster` and a
   * Worker has no process to scrape — so Workers Logs is the only thing standing between
   * an exception in the render path and silence. See D31.
   */
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  /** Content, the adaptation log, configuration, the rollups. */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morph",
      "database_id": "4226f0ff-184f-43db-a18f-e3d472df4540",
      "migrations_dir": "../../infra/d1/migrations",
    },
  ],

  "kv_namespaces": [
    /** Sticky assignments, keyed on the rotating daily anonymous id. 30-day TTL. */
    {
      "binding": "ASSIGNMENTS",
      "id": "367cbe6db3b34c4f8cb458760615164b",
    },
    /**
     * The published posterior snapshot: one key, rewritten hourly by the adapt cron and
     * read by every render. Separate from ASSIGNMENTS because the two have nothing in
     * common operationally — this one is a single hot key that must never be purged, that
     * one is millions of cold keys that expire on their own.
     */
    {
      "binding": "SNAPSHOT",
      "id": "248c2d1f7ba24720ab59687a1750c829",
    },
  ],

  /**
   * Instrument observations only.
   *
   * The renderer does not write behavioural events — the browser beacon goes to the ingest
   * Worker, which owns `morph_events`. Binding both here would have given this Worker a
   * capability it has no reason to hold, and D33's line is easier to keep when the wrong
   * dataset is simply not reachable from the render path.
   */
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "morph_metrics",
    },
  ],

  "vars": {
    /**
     * Not secrets. The public origin drives canonical URLs, feed self-links and OAuth
     * callbacks; MORPH_INDEXABLE defaults to "0" everywhere and is set to "1" on exactly
     * one deployment, because an indexed staging site outranks the real thing for its own
     * brand name and takes months to unwind.
     */
    "MORPH_PUBLIC_URL": "https://desirepath.live",
    "MORPH_INDEXABLE": "0",
    "MORPH_ENVIRONMENT_NAME": "production",

    /**
     * The data controller (D4) is NOT here. See the note below `vars`.
     */
  },

  /**
   * ANON_ID_PEPPER is a secret and is deliberately absent from this file.
   * `wrangler secret put ANON_ID_PEPPER` — it is the input to the visitor hash, and a
   * pepper in version control is a pepper that is no longer a pepper. The same value has
   * to be set on apps/api, or the two sides derive different ids for the same visitor.
   */

  /**
   * THE DATA CONTROLLER IS SET WITH `wrangler secret put`, NOT HERE (D4)
   *
   *   wrangler secret put MORPH_CONTROLLER_NAME
   *   wrangler secret put MORPH_CONTROLLER_ADDRESS
   *   wrangler secret put MORPH_CONTROLLER_EMAIL
   *
   * and the same three on apps/api, which gates every beacon on them.
   *
   * These three used to sit in `vars` above as empty strings, with a note offering
   * `wrangler secret put` as an alternative. The two cannot coexist: a `vars` entry and a
   * secret of the same name are one binding, the config's plain-text value is what a
   * deploy sends, and an empty string is what the deployment would then have. The failure
   * is quiet and total — the collector stops accepting beacons and `/privacy` reverts to
   * saying the controller is unconfigured, hours after a deploy that changed nothing else.
   *
   * So the entries are gone rather than empty. There is still no placeholder and no
   * example value, for the original reason: a plausible-looking controller in a privacy
   * notice is a false legal record, and worse than a missing one because it reads as
   * finished. Until all three are set the collector refuses every beacon with 503,
   * `/ready` names what is missing, and `/privacy` says so in those words.
   *
   * Secrets rather than `vars` for a second reason specific to this deployment: the
   * repository is public, and an operator who is a private individual has a residence for
   * an address. Art. 13 puts it on the privacy page either way — that is the point of it —
   * but a rendered page is not a mirrored, permanent, scrapeable git history.
   *
   * MORPH_CONTROLLER_DPO_EMAIL is optional and only applies if an Art. 37 data protection
   * officer has been appointed.
   */

  "env": {
    "staging": {
      "name": "desirepath-web-staging",
      "vars": {
        "MORPH_PUBLIC_URL": "https://staging.desirepath.live",
        "MORPH_INDEXABLE": "0",
        "MORPH_ENVIRONMENT_NAME": "staging",
      },
    },
  },
}
