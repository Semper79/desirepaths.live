{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Widened past this package for exactly one file: `bench/payload.js`, which builds the
    // load test's request bodies and is parsed by `test/bench-payload.test.ts` with the same
    // schema this service parses them with. The project emits nothing, so `rootDir` here is
    // a boundary rather than a layout instruction — and the boundary that matters is the one
    // ESLint and the workspace graph enforce, not this.
    "rootDir": "../..",
    // For that same file. k6 does not run TypeScript, so the builder cannot be `.ts`.
    "allowJs": true,
    "noEmit": true,
    // `node` for the Node-pool tests, `@cloudflare/workers-types` for the Worker entry's
    // `Request.cf` and handler types, and the pool's own types for `cloudflare:test` —
    // which is a virtual module and has no other way to resolve.
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "vitest.workers.config.ts"]
}
