/**
 * The event collector, as a Worker (D31, D34).
 *
 * Nothing here needs an id pasted in: Analytics Engine datasets are created on first write
 * and the rate limiter's namespace is a number this Worker chooses. That is why this config
 * has no REPLACE_ME placeholders while `apps/web` has three.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desirepath-ingest",
  "main": "src/worker.ts",

  /** Pinned. A Worker whose semantics change because time passed is an outage nobody can bisect. */
  "compatibility_date": "2026-09-01",

  /**
   * `enrich` reaches `@morph/core`, which uses Web Crypto rather than `node:crypto` — but
   * zod and the shared schemas still pull in Node built-ins through their own dependencies.
   * Without the flag the Worker fails at import time rather than at the first request.
   */
  "compatibility_flags": ["nodejs_compat"],

  /**
   * Full sampling, and this is the one service where that is worth the cost. The collector's
   * failure mode is a beacon that vanishes — not a page that breaks — so there is no user
   * report to fall back on and nothing else that would notice.
   */
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  /**
   * The exact per-variant counters (D33). One object per surface, addressed by name.
   *
   * This is the half of the measurement that sampling may never touch: Analytics Engine
   * holds the event stream and is sampled, these hold the numbers the posteriors are built
   * from and are not.
   */
  "durable_objects": {
    "bindings": [
      { "name": "COUNTERS", "class_name": "SurfaceCounters" },
      /**
       * One object per session, which folds it and hands the components to COUNTERS when
       * it closes (D36). Bound to the collector so a beacon can reach it, and the only
       * holder of a COUNTERS binding in its own right — the collector deliberately has
       * none, so the posteriors' source is reachable from exactly one place.
       */
      { "name": "SESSIONS", "class_name": "SessionAggregate" },
    ],
  },

  /**
   * `new_sqlite_classes`, not `new_classes`.
   *
   * SQLite-backed storage is the only kind the free plan can create, and it is the right
   * one regardless: the counters are read back as an hour range across several variants,
   * which is a query rather than a key lookup.
   *
   * Migration tags are append-only. A tag is never edited or removed once deployed — the
   * runtime replays the list to decide what has already been applied, so rewriting history
   * here is how an object loses its storage.
   */
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SurfaceCounters"] },
    { "tag": "v2", "new_sqlite_classes": ["SessionAggregate"] },
  ],

  "analytics_engine_datasets": [
    /**
     * The behavioural event stream. Sampled by the platform, and therefore never an input
     * to a posterior (D33) — the exact per-variant counters live in a Durable Object.
     */
    { "binding": "EVENTS", "dataset": "morph_events" },
    /**
     * `morph_*` instrument observations. A separate dataset rather than a shared one,
     * because sampling is applied per index value within a dataset and mixing a firehose
     * with an hourly gauge in the same one makes their rates argue with each other.
     */
    { "binding": "METRICS", "dataset": "morph_metrics" },
  ],

  /**
   * 120 beacons per minute per anonymous id.
   *
   * D34 sets out why this is a weaker guarantee than the token bucket it replaces and what
   * keeps the worst case bounded. The number is read back by
   * `test/bench-payload.test.ts` through wrangler's own parser, so the load test cannot go
   * on believing an old limit after this line changes.
   *
   * `namespace_id` is an identifier this Worker picks, not one Cloudflare issues. It only
   * has to be unique within the Worker.
   */
  "ratelimits": [
    {
      "name": "INGEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],

  "vars": {
    "MORPH_PUBLIC_URL": "https://desirepath.live",
    "MORPH_TIMEZONE": "Europe/Rome",

    /**
     * The data controller (D4). GDPR Art. 13 requires a visitor to be told who is
     * responsible and how to reach them before any processing happens.
     *
     * These are deliberately EMPTY in version control. There is no placeholder and no
     * example value, because a plausible-looking controller in a privacy notice is a false
     * legal record — worse than a missing one, since it reads as finished.
     *
     * Until all three are set:
     *   - the collector refuses every beacon with 503,
     *   - `/ready` refuses the deployment and names the missing variables,
     *   - `/privacy` says so in those words rather than rendering a gap.
     *
     * Set them with `wrangler secret put` if you would rather the address not sit in the
     * repository — they are not secrets in the cryptographic sense, but a private
     * individual's residence is personal data and belongs wherever the operator wants it.
     *
     * MORPH_CONTROLLER_DPO_EMAIL is optional and only applies if an Art. 37 data protection
     * officer has been appointed.
     */
    "MORPH_CONTROLLER_NAME": "",
    "MORPH_CONTROLLER_ADDRESS": "",
    "MORPH_CONTROLLER_EMAIL": "",
  },

  /**
   * ANON_ID_PEPPER is a secret and is absent on purpose:
   * `wrangler secret put ANON_ID_PEPPER`. It is the input to the visitor hash, and the
   * collector refuses readiness without it rather than hashing every visitor to one id.
   */
}
