# Keep the dependency graph explicit: a package may only import what it declares.
# This is load-bearing for `packages/adaptive`, which must stay dependency-free.
strict-peer-dependencies=false
auto-install-peers=true
link-workspace-packages=true
prefer-workspace-packages=true

# Keep sharp out of the hoisted virtual store.
#
# Next declares sharp as an optional dependency, for the image optimiser this site does not
# use — `images.unoptimized` is set, and there are no ImageResponse routes. The root
# manifest's `ignoredOptionalDependencies` stops it being installed for Next, but miniflare
# declares it as a *regular* dependency (for its Images binding emulation), and pnpm hoists
# that copy into `.pnpm/node_modules`, which sits on the module resolution path of every
# package in the virtual store — Next's included.
#
# That is enough for OpenNext's esbuild pass to resolve `require('sharp')` out of
# `next/dist/server/image-optimizer`, and then fail on the `.node` native binary it pulls
# in, because esbuild has no loader for one. `serverExternalPackages` does not help: it is
# a Next setting, and the bundle in question is not Next's.
#
# miniflare still gets sharp from its own `node_modules`, because it declares it. Hoisting
# is only a fallback for packages that import what they do not declare, which `.npmrc`
# above already says this repo does not tolerate.
#
# AND THE OVERRIDE IS STILL NEEDED, FOR A DIFFERENT REASON
# The root manifest also pins `sharp` to `^0.35.5`. That is not about the bundle — the two
# lines below are — it is CVE-2026-96889, a HIGH in librsvg affecting sharp below 0.35.5.
# Dropping the override while sorting out the bundling put the copy miniflare installs back
# at 0.35.4 and the `pnpm audit --prod --audit-level=high` gate caught it, because
# `@opennextjs/cloudflare` is a production dependency of `apps/web` and miniflare arrives
# through it. The pin costs nothing and is the only one of the three that is a security fix.
hoist-pattern[]=*
hoist-pattern[]=!sharp
hoist-pattern[]=!@img/sharp-*
hoist-pattern[]=!@img/sharp-libvips-*
